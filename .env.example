# TicketFlash - Variáveis de Ambiente (Exemplo)
# Copie este arquivo para .env para configurações locais personalizadas

# MongoDB
MONGO_URL=mongodb://mongo:27017
MONGO_DB=ticketflash

# Redis
REDIS_URL=redis://redis:6379/0

# Configurações de Cache e Limites da API
CACHE_TTL_SEGUNDOS=60
RESERVA_TTL_SEGUNDOS=600
LIMITE_RESERVAS_POR_MINUTO=10
JANELA_LIMITE_SEGUNDOS=60
